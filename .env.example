# ── NVIDIA NIM ────────────────────────────────────────────────
NIM_API_KEY=
NIM_ENDPOINT=
NIM_MODEL=
NIM_TIMEOUT=30000

# ── OpenRouter ─────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_TIMEOUT=30000

# ── Kernel governance switches ─────────────────────────────────
OLANG_PII_MODE=redact
OLANG_AUDIT_LOG=true
OLANG_EGRESS_MODE=allow

# ── Independent state store (Redis) ────────────────────────────
REDIS_URL=
MEMORY_TTL=3600

# ── Local validator (Ollama) ───────────────────────────────────
LOCAL_MODEL_ENDPOINT=http://localhost:11434
LOCAL_TIMEOUT=30000
LOCAL_MODEL=